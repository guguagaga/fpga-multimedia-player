# ============================================================================
# [CHG 2026-10-24 exp-io] EDA 扩展板 V3.0 经 40pin J1 接入
#---------------------------------------------------------------------------
# 引脚来自 HX4S20 手册的 J1 引脚分配表（docs/HX4S20_manual.txt 第 214-235 行）。
# 极性：扩展板 KEY0..KEY4 / SW0..SW7 都是"按下/拨到 ON = 拉到 GND = 低有效"，
#       板上已有上拉，这里再加 FPGA 内部 PULLUP 作为二道保险（插头没插时不悬空）。
#
# ★本表与交接文档第 5 节完全一致，SW3 就是 J1-19 = F14★
#   早期版本这里曾把 SW3 改到 K16，因为当时 F14 还是矩阵键盘的 keypad_col[1]。
#   2026-10-24 用户确认矩阵键盘不再接线，keypad_scan 已下线、8 个键盘脚位全部释放，
#   所以现在按交接文档的原始表格接线即可，不需要再改任何一根线。
#
# 历史记录（供回溯）：矩阵键盘原来占的是
#   J1-2 G11 / J1-4 F13 / J1-5 H13 / J1-19 F14 / J1-22 G14 / J1-25 H15 /
#   J1-33 N16 / J1-34 N14（并不是交接文档写的"J1-1~8"）。
#   这些脚位现在都空着，本表只用到其中的 F14(SW3)。
# ============================================================================

# ---- 扩展板按键 KEY0..KEY4（P1-20/21/22/23/24 -> J1-9/10/13/14/15）----
set_pin_assignment	{ exp_key[0] }	{ LOCATION = K12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-20 KEY0 = J1-9
set_pin_assignment	{ exp_key[1] }	{ LOCATION = L14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-21 KEY1 = J1-10
set_pin_assignment	{ exp_key[2] }	{ LOCATION = M14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-22 KEY2 = J1-13
set_pin_assignment	{ exp_key[3] }	{ LOCATION = P11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-23 KEY3 = J1-14
set_pin_assignment	{ exp_key[4] }	{ LOCATION = L10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-24 KEY4 = J1-15

# ---- 扩展板拨码 SW0..SW7（低有效）----
set_pin_assignment	{ exp_sw[0] }	{ LOCATION = M10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-2  SW0 = J1-16
set_pin_assignment	{ exp_sw[1] }	{ LOCATION = D16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-1  SW1 = J1-17
set_pin_assignment	{ exp_sw[2] }	{ LOCATION = E15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-4  SW2 = J1-18
set_pin_assignment	{ exp_sw[3] }	{ LOCATION = F14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-3  SW3 = J1-19
set_pin_assignment	{ exp_sw[4] }	{ LOCATION = F15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-6  SW4 = J1-20
set_pin_assignment	{ exp_sw[5] }	{ LOCATION = G16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-5  SW5 = J1-21
set_pin_assignment	{ exp_sw[6] }	{ LOCATION = J16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-8  SW6 = J1-24
set_pin_assignment	{ exp_sw[7] }	{ LOCATION = K15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }	# P1-7  SW7 = J1-23

# ---- 扩展板 74HC595 数码管（FPGA 输出）----
# set_pin_assignment	{ exp_seg_rclk }	{ LOCATION = M15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# P1-12 SEG7_RCLK = J1-31
# set_pin_assignment	{ exp_seg_dio }	{ LOCATION = L16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# P1-13 SEG7_DIO  = J1-32
# set_pin_assignment	{ exp_seg_sclk }	{ LOCATION = P16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# P1-15 SEG7_SCLK = J1-35
