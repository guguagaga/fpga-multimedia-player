# ===== 板载独立按键（HX4S20 手册 p19：KEY1=A2 KEY2=B2 KEY3=B1 KEY4=C1）=====
# 【2026-10-02 修复 现象3】原来 B2(KEY2) 同时被图片轮播(sd_card_bmp.key_next)
#   和音乐控制(button_ctrl.key_a)使用 —— 一个物理键驱动两个状态机，图片索引
#   和曲目索引各跑各的，就出现"歌名与正在播放的歌对不上"。
#   现在把图片控制单独挪到 B1(KEY3)：key3 = 手动下一张图（独立）。
#   A2(KEY1) 仍作复位、B2(KEY2) 仍作 key1（音乐 播放/暂停 + 长按快进）、
#   C1(KEY4) 仍作 key2（自动续播 开/关）—— 这三路保持原样，一行未改。
set_pin_assignment	{ key3 }	{ LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ key1 }	{ LOCATION = B2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ key2 }	{ LOCATION = C1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ rst_n }	{ LOCATION = A2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ sd_dclk }	{ LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ sd_miso }	{ LOCATION = B14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ sd_mosi }	{ LOCATION = A13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ sd_ncs }	{ LOCATION = A12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[0] }	{ LOCATION = C15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_data[1] }	{ LOCATION = C16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
